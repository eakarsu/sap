DATABASE_URL=postgresql://app_user:replace-me@127.0.0.1:5432/sap_crm
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://127.0.0.1:4002
APP_HOST=127.0.0.1
BACKEND_PORT=4002
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Destructive fixture seed, for a new disposable database only:
# ALLOW_DESTRUCTIVE_SEED=YES
# SEED_ADMIN_EMAIL=operator@example.com
# SEED_ADMIN_PASSWORD=replace-with-at-least-16-characters
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
